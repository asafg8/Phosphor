{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "additionalProperties": {},
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warn",
            "skip"
          ],
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "E_NO_DISK",
            "E_EXT_REBUILD",
            "E_SOURCE_INTEGRITY",
            "E_ARTIFACT_INTEGRITY",
            "E_BUILD_FAILED",
            "E_DEPS_INSTALL",
            "E_PREFLIGHT",
            "E_NOT_ELIGIBLE",
            "E_LAB_FLAG",
            "E_ROOT_UNREADABLE",
            "E_MANIFEST",
            "E_USAGE",
            "E_SCAN_FAILED",
            "E_SWAP_FAILED",
            "E_SWAP_VERIFY",
            "E_ROLLBACK_FAILED",
            "E_TIMEOUT",
            "E_UNSUPPORTED",
            "E_INTERNAL",
            "E_PATCH_APPLY",
            "E_DRIFT",
            "E_VERSION_PATCH",
            "E_SMOKE",
            "E_DEPS_UNAVAILABLE",
            "E_SOURCE_UNVERIFIED",
            "E_RESULT_MISSING",
            "E_NO_MEMORY",
            "E_TELEMETRY_IN_BUILD",
            "E_VERDICT_REQUIRED",
            "E_BUSY"
          ],
          "type": "string"
        },
        "data": {
          "additionalProperties": {},
          "type": "object"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "LintError": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "integer"
        },
        "msg": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "msg"
      ],
      "type": "object"
    },
    "LintResult": {
      "additionalProperties": false,
      "properties": {
        "errors": {
          "items": {
            "$ref": "#/$defs/LintError"
          },
          "type": "array"
        },
        "files": {
          "type": "integer"
        }
      },
      "required": [
        "errors",
        "files"
      ],
      "type": "object"
    },
    "ModuleDiff": {
      "additionalProperties": false,
      "properties": {
        "extra": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "extra",
        "missing"
      ],
      "type": "object"
    },
    "Preflight": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "type": "array"
        },
        "decision": {
          "enum": [
            "go",
            "no-go"
          ],
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Error"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "lint": {
          "$ref": "#/$defs/LintResult"
        },
        "module_diff": {
          "$ref": "#/$defs/ModuleDiff"
        },
        "no_go_reasons": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "phosphor_version": {
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        },
        "runtimes": {
          "items": {
            "$ref": "#/$defs/StepRuntime"
          },
          "type": "array"
        },
        "schema": {
          "type": "string"
        },
        "skipped_by_lab": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "blocked"
          ],
          "type": "string"
        }
      },
      "required": [
        "checks",
        "decision",
        "lint",
        "module_diff",
        "no_go_reasons",
        "phosphor_version",
        "runtime_id",
        "runtimes",
        "schema",
        "started_at",
        "status"
      ],
      "type": "object"
    },
    "StepRuntime": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "same-minor-build",
            "needs-code-change",
            "needs-migration",
            "report-only",
            "distro-update",
            "none"
          ],
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "inspected",
            "scanned",
            "preflighted",
            "swapped",
            "rolled-back",
            "blocked",
            "needs-code-change",
            "needs-migration",
            "failed",
            "report-only",
            "held"
          ],
          "type": "string"
        },
        "verify": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/StepVerify"
            }
          ]
        }
      },
      "required": [
        "runtime_id"
      ],
      "type": "object"
    },
    "StepVerify": {
      "additionalProperties": false,
      "properties": {
        "new_binary_live": {
          "type": "boolean"
        }
      },
      "required": [
        "new_binary_live"
      ],
      "type": "object"
    }
  },
  "$id": "https://phosphor.dev/schema/phosphor/preflight.json",
  "$ref": "#/$defs/Preflight",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
