{
  "$defs": {
    "Error": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "E_NO_DISK",
            "E_EXT_REBUILD",
            "E_SOURCE_INTEGRITY",
            "E_ARTIFACT_INTEGRITY",
            "E_BUILD_FAILED",
            "E_DEPS_INSTALL",
            "E_PREFLIGHT",
            "E_NOT_ELIGIBLE",
            "E_LAB_FLAG",
            "E_ROOT_UNREADABLE",
            "E_MANIFEST",
            "E_USAGE",
            "E_SCAN_FAILED",
            "E_SWAP_FAILED",
            "E_SWAP_VERIFY",
            "E_ROLLBACK_FAILED",
            "E_TIMEOUT",
            "E_UNSUPPORTED",
            "E_INTERNAL",
            "E_PATCH_APPLY",
            "E_DRIFT",
            "E_VERSION_PATCH",
            "E_SMOKE",
            "E_DEPS_UNAVAILABLE",
            "E_SOURCE_UNVERIFIED",
            "E_RESULT_MISSING",
            "E_NO_MEMORY",
            "E_TELEMETRY_IN_BUILD",
            "E_VERDICT_REQUIRED",
            "E_BUSY"
          ],
          "type": "string"
        },
        "data": {
          "additionalProperties": {},
          "type": "object"
        }
      },
      "required": [
        "code"
      ],
      "type": "object"
    },
    "PkgFetch": {
      "additionalProperties": false,
      "properties": {
        "dir": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Error"
            }
          ]
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "format": "date-time",
              "type": "string"
            }
          ]
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/PkgFetchPackage"
          },
          "type": "array"
        },
        "phosphor_version": {
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "skipped_host_mirror_reason": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "blocked"
          ],
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "dir",
        "packages",
        "phosphor_version",
        "runtime_id",
        "schema",
        "source",
        "started_at",
        "status",
        "version"
      ],
      "type": "object"
    },
    "PkgFetchPackage": {
      "additionalProperties": false,
      "properties": {
        "pkg": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "via": {
          "type": "string"
        }
      },
      "required": [
        "pkg",
        "sha256",
        "version",
        "via"
      ],
      "type": "object"
    }
  },
  "$id": "https://phosphor.dev/schema/phosphor/pkg-fetch.json",
  "$ref": "#/$defs/PkgFetch",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
